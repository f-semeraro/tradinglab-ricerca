# dipendenze: il laboratorio non ne ha, ma se mai ne aggiungerai non vanno pubblicate
node_modules/

# variabili d'ambiente e segreti: nel laboratorio non ce ne devono essere, e questo serve a impedirlo
.env
.env.*

# file temporanei di scrittura atomica e log
*.tmp
*.log

# archivio Kraken scaricato a mano (ZIP e CSV grezzi) e candele a 30 minuti ricavate da esso:
# pesanti, restano in locale. I report e il registro dei backtest a 30 minuti sì, vanno nel repository.
dati/archivio/
dati/storico/*-30.csv

# sistema operativo e editor
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
